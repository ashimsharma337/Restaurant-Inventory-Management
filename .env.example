# App
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mydb
DB_SSL=false # for Docker
# DB_SSL=true # for Cloud because cloud databases forces ssl

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# S3 document attachments (LocalStack during development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=restaurant-inventory-documents
S3_ENDPOINT=http://localhost:4566
